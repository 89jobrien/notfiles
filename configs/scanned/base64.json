{
  "name": "base64",
  "description": "Use when you need to encode or decode Base64 data in Rust; supports standard, URL-safe, and custom alphabets with optional padding control.",
  "base_url": "https://docs.rs/base64/0.22",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://docs.rs/base64/0.22",
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
        "code_blocks": "pre code"
      },
      "url_patterns": {
        "include": [],
        "exclude": []
      }
    },
    {
      "type": "github",
      "repo": "marshallpierce/rust-base64",
      "enable_codebase_analysis": true,
      "code_analysis_depth": "deep",
      "fetch_issues": false
    }
  ],
  "categories": {
    "encoding": [
      "encode",
      "decode",
      "base64",
      "alphabet",
      "padding"
    ],
    "io": [
      "read",
      "write",
      "stream",
      "chunked"
    ],
    "configuration": [
      "engine",
      "config",
      "alphabet",
      "url_safe",
      "standard"
    ],
    "error_handling": [
      "DecodeError",
      "EncodeError",
      "invalid",
      "padding"
    ],
    "data_types": [
      "bytes",
      "string",
      "slice",
      "vec"
    ]
  },
  "rate_limit": 0.5,
  "max_pages": 250,
  "metadata": {
    "version": "1.0.0",
    "framework": "base64",
    "detected_version": "0.22"
  }
}
