{
  "name": "rpassword",
  "description": "Use when you need to securely prompt users for passwords or sensitive strings at the terminal without echoing input; suitable for CLI tools and daemons that require runtime credential entry.",
  "base_url": "https://docs.rs/rpassword",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://docs.rs/rpassword",
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
        "code_blocks": "pre code"
      },
      "url_patterns": {
        "include": [],
        "exclude": []
      }
    },
    {
      "type": "github",
      "repo": "conradkleinespel/rpassword",
      "enable_codebase_analysis": true,
      "code_analysis_depth": "deep",
      "fetch_issues": false
    }
  ],
  "categories": {
    "authentication": [
      "password",
      "credential",
      "secret",
      "passphrase"
    ],
    "terminal": [
      "tty",
      "stdin",
      "echo",
      "console",
      "prompt"
    ],
    "security": [
      "sensitive",
      "masking",
      "hidden",
      "secure-input"
    ],
    "cli": [
      "command-line",
      "interactive",
      "user-input",
      "read-password"
    ],
    "io": [
      "read",
      "input",
      "stream",
      "stdin"
    ]
  },
  "rate_limit": 0.5,
  "max_pages": 250,
  "metadata": {
    "version": "1.0.0",
    "framework": "rpassword",
    "detected_version": "7"
  }
}
