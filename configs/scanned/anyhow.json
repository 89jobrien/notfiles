{
  "name": "anyhow",
  "description": "Use anyhow when you need ergonomic, context-rich error handling in application code \u2014 it provides a single opaque error type that carries a chain of human-readable context messages.",
  "base_url": "https://docs.rs/anyhow",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://docs.rs/anyhow",
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
        "code_blocks": "pre code"
      },
      "url_patterns": {
        "include": [],
        "exclude": []
      }
    },
    {
      "type": "github",
      "repo": "dtolnay/anyhow",
      "enable_codebase_analysis": true,
      "code_analysis_depth": "deep",
      "fetch_issues": false
    }
  ],
  "categories": {
    "error-handling": [
      "anyhow",
      "error",
      "result",
      "context",
      "bail",
      "ensure"
    ],
    "ergonomics": [
      "ergonomic",
      "idiomatic",
      "convenient",
      "opaque"
    ],
    "error-propagation": [
      "propagation",
      "question-mark",
      "chain",
      "source",
      "cause"
    ],
    "diagnostics": [
      "backtrace",
      "display",
      "debug",
      "message",
      "context-chain"
    ],
    "application-code": [
      "binary",
      "application",
      "main",
      "non-library",
      "top-level"
    ]
  },
  "rate_limit": 0.5,
  "max_pages": 250,
  "metadata": {
    "version": "1.0.0",
    "framework": "anyhow",
    "detected_version": "1"
  }
}
