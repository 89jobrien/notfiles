{
  "name": "clap",
  "description": "Use clap when you need to parse command-line arguments in a Rust application. It handles subcommands, flags, options, and help text generation with derive macros or a builder API.",
  "base_url": "https://docs.rs/clap/latest/clap/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://docs.rs/clap/latest/clap/",
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
        "code_blocks": "pre code"
      },
      "url_patterns": {
        "include": [],
        "exclude": []
      }
    },
    {
      "type": "github",
      "repo": "clap-rs/clap",
      "enable_codebase_analysis": true,
      "code_analysis_depth": "deep",
      "fetch_issues": false
    }
  ],
  "categories": {
    "argument_parsing": [
      "args",
      "flags",
      "options",
      "positional",
      "parse",
      "from_args"
    ],
    "subcommands": [
      "subcommand",
      "command",
      "Commands",
      "Subcommand"
    ],
    "derive_api": [
      "derive",
      "Parser",
      "Args",
      "Subcommand",
      "ValueEnum",
      "clap::Parser"
    ],
    "builder_api": [
      "Command",
      "Arg",
      "ArgMatches",
      "builder",
      "get_matches"
    ],
    "validation": [
      "validator",
      "value_parser",
      "conflicts_with",
      "requires",
      "group"
    ],
    "help_and_display": [
      "help",
      "about",
      "version",
      "long_about",
      "display_order"
    ]
  },
  "rate_limit": 0.5,
  "max_pages": 250,
  "metadata": {
    "version": "1.0.0",
    "framework": "clap v4",
    "detected_version": "4"
  }
}
