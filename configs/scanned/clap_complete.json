{
  "name": "clap_complete",
  "description": "Use when you need to generate shell completion scripts for CLI applications built with clap. Supports Bash, Zsh, Fish, PowerShell, Elvish, and other shells.",
  "base_url": "https://docs.rs/clap_complete",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://docs.rs/clap_complete/4",
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
        "code_blocks": "pre code"
      },
      "url_patterns": {
        "include": [],
        "exclude": []
      }
    },
    {
      "type": "github",
      "repo": "clap-rs/clap",
      "enable_codebase_analysis": true,
      "code_analysis_depth": "deep",
      "fetch_issues": false
    }
  ],
  "categories": {
    "shell_completion": [
      "bash",
      "zsh",
      "fish",
      "powershell",
      "elvish",
      "completion"
    ],
    "cli": [
      "clap",
      "argument_parser",
      "command_line",
      "cli"
    ],
    "code_generation": [
      "generate",
      "shell_script",
      "autocompletion"
    ],
    "integration": [
      "build_script",
      "include_str",
      "generate_to"
    ],
    "dynamic_completion": [
      "dynamic",
      "engine",
      "custom_completion"
    ]
  },
  "rate_limit": 0.5,
  "max_pages": 250,
  "metadata": {
    "version": "1.0.0",
    "framework": "clap_complete",
    "detected_version": "4"
  }
}
