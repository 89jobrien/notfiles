{
  "name": "chrono",
  "description": "Use for date and time handling in Rust \u2014 parsing, formatting, arithmetic, timezone conversion, and duration calculations. Prefer when you need RFC 3339 / ISO 8601 support or human-readable datetime manipulation.",
  "base_url": "https://docs.rs/chrono/0.4/chrono/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://docs.rs/chrono/0.4/chrono/",
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
        "code_blocks": "pre code"
      },
      "url_patterns": {
        "include": [],
        "exclude": []
      }
    },
    {
      "type": "github",
      "repo": "chronotope/chrono",
      "enable_codebase_analysis": true,
      "code_analysis_depth": "deep",
      "fetch_issues": false
    }
  ],
  "categories": {
    "parsing": [
      "parse",
      "from_str",
      "strptime",
      "NaiveDate",
      "NaiveDateTime",
      "DateTime"
    ],
    "formatting": [
      "format",
      "strftime",
      "to_rfc3339",
      "to_rfc2822",
      "Display"
    ],
    "arithmetic": [
      "Duration",
      "checked_add",
      "checked_sub",
      "signed_duration_since"
    ],
    "timezones": [
      "TimeZone",
      "Utc",
      "Local",
      "FixedOffset",
      "with_timezone"
    ],
    "types": [
      "NaiveDate",
      "NaiveTime",
      "NaiveDateTime",
      "DateTime",
      "Date",
      "Datelike",
      "Timelike"
    ],
    "utilities": [
      "Weekday",
      "Month",
      "IsoWeek",
      "offset",
      "timestamp",
      "unix_timestamp"
    ]
  },
  "rate_limit": 0.5,
  "max_pages": 250,
  "metadata": {
    "version": "1.0.0",
    "framework": "chrono",
    "detected_version": "0.4"
  }
}
